# ========================================
# VNPAY PAYMENT CONFIGURATION
# ========================================

# VNPAY URL - Sandbox hoặc Production
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# VNPAY Merchant Code - Lấy từ VNPAY Admin
VNPAY_TMN_CODE=1VYBIYQP

# VNPAY Secret Key - Lấy từ VNPAY Admin (Giữ bí mật!)
VNPAY_HASH_SECRET=NOH6MBGNLQL9O9OMMFMZ2AX8NIEP50W1

# VNPAY Return URL - Callback URL sau khi thanh toán
VNPAY_RETURN_URL=http://127.0.0.1:8000/vnpay-callback

# ========================================
# Hướng dẫn cấu hình
# ========================================
# 1. Truy cập https://sandbox.vnpayment.vn hoặc https://admin.vnpay.vn
# 2. Lấy mã Merchant Code (TMN_CODE) từ "Cài đặt" → "Chung"
# 3. Lấy Secret Key (HASH_SECRET) từ "Cài đặt" → "API"
# 4. Cập nhật VNPAY_RETURN_URL thành URL công khai khi deploy
# 5. Thay đổi VNPAY_URL khi chuyển sang Production:
#    Production: https://pay.vnpay.vn/vpcpay.html
